FROM oven/bun:1.4.3-alpine@sha256:629e17411f1f129dbec3af78d5af9c9f2a937435c80349437206c6b0b7422373 AS builder

WORKDIR /panel

COPY web/management-center/package.json web/management-center/bun.lock ./
RUN --mount=type=cache,id=cpamc-bun-1.4.3,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY web/management-center/ ./

ARG CPAMC_COMMIT
ARG PANEL_BUILD_NONCE=""
RUN : "$PANEL_BUILD_NONCE" && test -n "$CPAMC_COMMIT" && VERSION="$CPAMC_COMMIT" bun run build \
    && mkdir -p dist/management-assets

FROM scratch

COPY --from=builder /panel/dist/index.html /management.html
COPY --from=builder /panel/dist/management-assets /management-assets
