<clickhouse>
    <!--
        Bounds ClickHouse's own system log tables, which otherwise grow forever in the
        stock server image (query_log even ships with its TTL commented out).

        Mount this file read-only at /etc/clickhouse-server/config.d/ when running the
        ClickHouse server with CPA. The TTL applies when a log table is created; on an
        existing deployment see docs/clickhouse.md for how to apply and reclaim space.
    -->

    <!-- Query and part lifecycle logs keep a week of history. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <query_thread_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_thread_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_views_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </background_schedule_pool_log>

    <!-- Server text log. Warning and above is enough for postmortems. -->
    <text_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <level>warning</level>
    </text_log>

    <!-- Metric collection logs, written every second by default. -->
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>

    <!-- Remaining configured system logs. Most stay empty until their feature is used. -->
    <iceberg_metadata_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </iceberg_metadata_log>
    <delta_lake_metadata_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </delta_lake_metadata_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </processors_profile_log>
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_insert_log>
    <backup_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </backup_log>
    <s3queue_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </s3queue_log>
    <blob_storage_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </blob_storage_log>
    <aggregated_zookeeper_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </aggregated_zookeeper_log>
    <zookeeper_connection_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </zookeeper_connection_log>
    <crash_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </crash_log>

    <!-- Profiling-only logs. CPA does not consume their data. -->
    <trace_log remove="1"/>
    <instrumentation_trace_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
